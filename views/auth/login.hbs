{{!< layouts/main}}
<h2>Iniciar sesión</h2>

{{#if errors}}
  <div class="alert">
    <ul>
      {{#each errors}}
        <li>{{this.msg}}</li>
      {{/each}}
    </ul>
  </div>
{{/if}}

<form action="/login" method="POST" class="card">
  <label>Usuario
    <input type="text" name="username" value="{{old.username}}">
  </label>
  <label>Contraseña
    <input type="password" name="password">
  </label>
  <button type="submit">Ingresar</button>
</form>

<p><em>Usuario semilla:</em> <strong>admin</strong> / <strong>admin123</strong></p>
