<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{#if title}}{{title}} | {{/if}}MiInventarioExpress</title>
  <link rel="stylesheet" href="/public/css/styles.css">
</head>
<body>
  <header class="topbar">
    <h1><a href="/">MiInventarioExpress</a></h1>
    <nav>
      {{#if user}}
        <a href="/productos">Productos</a>
        <a href="/chat">Chat</a>
        <form action="/logout" method="POST" style="display:inline">
          <button type="submit">Salir ({{user.username}})</button>
        </form>
      {{else}}
        <a href="/login">Login</a>
      {{/if}}
    </nav>
  </header>

  <main class="container">
    {{{body}}}
  </main>

  <footer class="footer">
    <small>UPS — Aplicaciones Web • {{year}}</small>
  </footer>
  <script>
    window.year = new Date().getFullYear();
    document.querySelector('.footer small').textContent = "UPS — Aplicaciones Web • " + window.year;
  </script>
</body>
</html>
