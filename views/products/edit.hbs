{{!< layouts/main}}
<h2>Editar producto</h2>

{{#if errors}}
  <div class="alert">
    <ul>
      {{#each errors}}
        <li>{{this.msg}}</li>
      {{/each}}
    </ul>
  </div>
{{/if}}

<form action="/productos/{{p._id}}" method="POST" enctype="multipart/form-data" class="card">
  <label>Nombre
    <input type="text" name="nombre" value="{{p.nombre}}">
  </label>
  <label>Precio
    <input type="number" step="0.01" name="precio" value="{{p.precio}}">
  </label>
  <label>Descripción
    <textarea name="descripcion">{{p.descripcion}}</textarea>
  </label>
  <p>Imagen actual: {{#if p.imagen}}<img src="{{p.imagen}}" class="thumb">{{else}}(sin imagen){{/if}}</p>
  <label>Nueva imagen (opcional)
    <input type="file" name="imagen" accept="image/*">
  </label>
  <button type="submit">Actualizar</button>
</form>
